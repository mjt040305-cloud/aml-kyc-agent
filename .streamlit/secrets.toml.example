# Copy this file to secrets.toml (which is gitignored) for local development,
# or paste its contents into the Streamlit Community Cloud "Secrets" panel
# when deploying. This app does not require any secrets to run in its
# current rule-based form - this file is provided so you can extend the
# agent (e.g. with an LLM-generated narrative summary) without ever
# committing a real API key to GitHub.

# ANTHROPIC_API_KEY = "sk-ant-..."
